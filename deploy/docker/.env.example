SURF_IMAGE_TAG=latest
SURF_ROLE=drone
ROS_DOMAIN_ID=26
# Keep robot-to-robot DDS off the radios; network_bridge owns that traffic.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
SURF_ROBOT_CONFIG=/absolute/path/to/robot.yaml
SURF_TRANSPORT_CONFIG=/absolute/path/to/transport.yaml
SURF_MAP_DIRECTORY=/absolute/path/to/maps
SURF_TELEMETRY_DIRECTORY=/absolute/path/to/telemetry
