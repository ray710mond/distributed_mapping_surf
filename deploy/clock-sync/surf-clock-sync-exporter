#!/usr/bin/env python3
"""Publish current clock proof, including explicit loss of synchronization."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

sys.path.insert(0, '/usr/local/lib/surf')
from clock import clock_document


def main():
    peer = os.environ['SURF_CLOCK_PEER']
    output = Path('/run/surf-clock-sync/status.json')
    output.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    while True:
        try:
            tracking = subprocess.run(
                ['chronyc', '-c', 'tracking'], capture_output=True, text=True,
                timeout=2, check=True).stdout
            doc = clock_document(tracking, peer=peer)
        except (OSError, subprocess.SubprocessError, ValueError):
            doc = None
        if doc is None:
            doc = {'verified': False, 'reason': 'Chrony has no verified time source',
                   'measured_at_unix_ns': time.time_ns()}
        temporary = output.with_suffix('.tmp')
        temporary.write_text(json.dumps(doc, indent=2) + '\n')
        os.chmod(temporary, 0o644)
        temporary.replace(output)
        time.sleep(10)


if __name__ == '__main__':
    main()
