#!/usr/bin/env python3
import csv, json, math, os, subprocess, time
from datetime import datetime, timezone
from pathlib import Path

peer = os.environ['SURF_CLOCK_PEER']
output = Path('/run/surf-clock-sync/status.json')
output.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
while True:
    try:
        sources = subprocess.run(['chronyc', 'sources', '-n'], capture_output=True,
                                 text=True, timeout=2).stdout
        selected = any(line.startswith('^*') and peer in line for line in sources.splitlines())
        row = next(csv.reader([subprocess.run(
            ['chronyc', '-c', 'tracking'], capture_output=True, text=True,
            timeout=2, check=True).stdout.strip()]))
        if selected and len(row) >= 13 and row[-1].strip().lower() == 'normal':
            system, rms, delay, dispersion = map(float, (row[-10], row[-8], row[-4], row[-3]))
            uncertainty = (abs(system) + abs(rms) + .5 * abs(delay) + abs(dispersion)) * 1000
            if math.isfinite(uncertainty):
                doc = {'verified': True, 'method': 'chrony-halow-client', 'source': peer,
                       'offset_ms': system * 1000, 'uncertainty_ms': uncertainty,
                       'measured_at_unix_ns': time.time_ns(),
                       'measured_at_utc': datetime.now(timezone.utc).isoformat()}
                temporary = output.with_suffix('.tmp')
                temporary.write_text(json.dumps(doc, indent=2) + '\n')
                os.chmod(temporary, 0o644)
                temporary.replace(output)
    except (OSError, subprocess.SubprocessError, StopIteration, ValueError):
        pass
    time.sleep(10)
