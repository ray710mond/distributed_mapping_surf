[Unit]
Description=Continuously export SURF internet/HaLow clock status
After=chrony.service network-online.target
Wants=chrony.service

[Service]
Type=simple
EnvironmentFile=/etc/surf/clock-sync.env
ExecStart=/usr/local/sbin/surf-clock-sync-exporter
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
