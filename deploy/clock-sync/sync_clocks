#!/usr/bin/env bash
set -Eeuo pipefail

# Wait for Chrony to have a usable source and <=10 ms remaining correction.
# Chrony continues disciplining the clock after this command returns.
tries=${SYNC_CLOCKS_TRIES:-60}
echo "Waiting for Chrony synchronization (up to $((tries * 10 / 60)) minutes)..."
if ! chronyc waitsync "$tries" 0.01; then
    echo "Clock synchronization failed; check internet/HaLow connectivity." >&2
    chronyc -n tracking || true
    chronyc -n sources || true
    exit 1
fi

clock-sync-status
if command -v surf-preflight >/dev/null 2>&1; then
    surf-preflight
fi
echo "Clock ready. Leave Chrony running during the experiment."
