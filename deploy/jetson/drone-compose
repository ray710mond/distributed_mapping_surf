#!/usr/bin/env bash
set -euo pipefail

# Keep the drone's base deployment and persistent development overlay together.
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
env_file="${SURF_ENV_FILE:-${script_dir}/.env}"

exec docker compose \
  --env-file "${env_file}" \
  -f "${script_dir}/compose.yaml" \
  -f "${script_dir}/compose.dev.yaml" \
  "$@"
