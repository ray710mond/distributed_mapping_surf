# Drone Jetson MID-360 Ethernet addresses.
LIVOX_HOST_IP=192.168.1.99
LIVOX_LIDAR_IP=192.168.1.120

# Absolute path on this Jetson; ~ is not expanded in a Compose env file.
LIVOX_SDK2_SOURCE=/home/user/Livox-SDK2-v1.3.1

# Absolute host path containing any number of maps/<map_name> directories.
# Select a map per launch with map_name:=<name>. This may point into a private
# parent repository when this project is checked out as a submodule.
SURF_MAP_DIRECTORY=/absolute/path/to/maps

# Absolute host directory exposed at /data/telemetry in the container. This
# makes finalized runs available to the laptop through ordinary SSH/rsync.
SURF_TELEMETRY_DIRECTORY=/home/user/SURF_2026/experiments

# The laptop humanoid runs separately; keep DDS discovery local to this Jetson.
ROS_DOMAIN_ID=26

# Must match the PX4 firmware message definitions. For the most reliable match,
# use the commit printed by:
# git -C ~/ws_offboard_control/src/px4_msgs rev-parse HEAD
# A matching release branch such as release/1.15 is also accepted.
PX4_MSGS_REF=release/1.15

# Jetson deployment target. Use linux/amd64 only for workstation testing.
SURF_PLATFORM=linux/arm64

# Used only with compose.pixhawk.yaml. Prefer the stable /dev/serial/by-id path.
PIXHAWK_DEVICE=/dev/ttyACM0
