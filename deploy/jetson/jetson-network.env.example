# Copy to jetson-network.env and adjust machine-specific values before running
# install-surf-jetson-network-tools.sh. This file contains no credentials;
# passwords remain in root-owned NetworkManager connection profiles.

# Jetson Intel 5 GHz interface and its two saved NetworkManager profiles.
SURF_JETSON_WIFI_IF=wlP1p1s0
SURF_JETSON_INTERNET_PROFILE="Caltech Secure"
SURF_JETSON_TEST_PROFILE="SURF-Robot-Net"

# Independent HaLow management link. Mode switching refuses to proceed unless
# the laptop peer is routed through this interface, protecting the SSH session.
SURF_JETSON_HALOW_IF=wlx0cbf7400343c
SURF_JETSON_HALOW_PEER=10.43.30.2

# Expected static Jetson address on SURF-Robot-Net.
SURF_JETSON_TEST_ADDR=10.42.20.2/24
SURF_TELEMETRY_USER=YOUR_JETSON_USERNAME
