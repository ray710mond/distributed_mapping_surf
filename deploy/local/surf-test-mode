#!/usr/bin/env bash
set -Eeuo pipefail
CONFIG_FILE=${SURF_LOCAL_CONFIG:-/etc/surf/local.env}
source "$CONFIG_FILE"
PEER=${SURF_HALOW_PEER:?HaLow peer is required}
INTERFACE=${SURF_HALOW_IF:?HaLow interface is required}
route=$(ip route get "$PEER")
if [[ $route != *" dev $INTERFACE "* ]]; then
    echo "Peer $PEER is not routed over $INTERFACE." >&2
    exit 1
fi
# Do not switch Wi-Fi or step the clock: this is safe during an existing run.
chronyc waitsync 30 0.01 0 1
clock-sync-status
echo "HaLow peer route and clock ready; internet Wi-Fi remains connected."
