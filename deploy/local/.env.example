# Copy this file to .env and replace the machine-specific/private values before installing.
# The local .env should remain ignored by Git.

# ---------------------------------------------------------------------------
# Laptop 5 GHz management network
# ---------------------------------------------------------------------------
#
# The Intel Wi-Fi radio operates in one of two manually selected modes:
#
#   sudo surf-normal-mode
#       Normal NetworkManager Wi-Fi connection (for Internet/development).
#
#   sudo surf-test-mode
#       Disconnect normal Wi-Fi and create the standalone SURF-Robot-Net AP.
#
# The physical Wi-Fi interface remains managed by NetworkManager in both modes.
# Test mode does not require or provide an Internet uplink.

# Physical Wi-Fi interface used for both normal Wi-Fi and the standalone AP.
SURF_UPLINK_IF=YOUR_WIFI_INTERFACE

# Virtual AP interface created only while SURF test mode is active.
SURF_AP_IF=ap0

# Robot management Wi-Fi.
SURF_WIFI5_SSID=SURF-Robot-Net
SURF_WIFI5_PASSPHRASE=YOUR_PRIVATE_WIFI_PASSWORD
SURF_WIFI5_CHANNEL=40

# Laptop-side management network configuration.
SURF_WIFI5_AP_ADDR=10.42.20.1
SURF_WIFI5_AP_PREFIX=24
SURF_WIFI5_NETMASK=255.255.255.0
SURF_WIFI5_AP_NET=10.42.20.0/24
SURF_WIFI5_PEER_ADDR=10.42.20.2
SURF_WIFI5_DHCP_START=10.42.20.10
SURF_WIFI5_DHCP_END=10.42.20.250

# Regulatory domain for the 5 GHz AP.
SURF_COUNTRY=YOUR_ISO_3166_ALPHA2_COUNTRY

# NetworkManager connection profile to restore when leaving test mode.
SURF_NORMAL_WIFI_PROFILE="YOUR_NORMAL_WIFI_PROFILE"

# ---------------------------------------------------------------------------
# Morse Micro RD09/MM8108 Wi-Fi HaLow
# ---------------------------------------------------------------------------
#
# HaLow is a separate radio/link and is not switched by surf-test-mode or
# surf-normal-mode.

MORSE_COUNTRY=YOUR_ISO_3166_ALPHA2_COUNTRY
MORSE_BCF_SOURCE=bcf/morsemicro/YOUR_BOARD_CONFIG.bin
SURF_HALOW_IF=YOUR_HALOW_INTERFACE
SURF_HALOW_SUBNET=10.43.30.0/24
SURF_TELEMETRY_USER=YOUR_LOCAL_USERNAME

# Optional collection settings used by surf-collate-run. The repository path
# is discovered from /etc/surf/repository.env after installing the CLI wrappers;
# export SURF_PROJECT_ROOT only to override that checkout.
# SURF_PROJECT_ROOT=/absolute/path/to/distributed_mapping_surf
# SURF_LOCAL_EXPERIMENTS=/absolute/path/to/local/telemetry
# SURF_DRONE_EXPERIMENTS=user@peer:/absolute/path/to/remote/telemetry

# Optional space-separated board-type aliases, without the 0x prefix.
MORSE_BCF_BOARDTYPE_ALIASES=
