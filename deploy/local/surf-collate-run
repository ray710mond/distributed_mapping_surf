#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: surf-collate-run <tracker_run_id>" >&2
    exit 2
fi

RUN_ID=$1
if [[ ! $RUN_ID =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
    echo "Invalid run ID: $RUN_ID" >&2
    exit 2
fi

if [[ -r /etc/surf/repository.env ]]; then
    # Installed by install-surf-cli.sh; keep the command independent of the
    # caller's working directory and shell environment.
    source /etc/surf/repository.env
fi
PROJECT_ROOT=${SURF_PROJECT_ROOT:-${SURF_REPOSITORY:-}}
: "${PROJECT_ROOT:?Set SURF_PROJECT_ROOT or reinstall the SURF CLI wrappers}"
TRACKER_SOURCE=${SURF_TRACKER_SOURCE:-$PROJECT_ROOT/surf_data_tracker}
LOCAL_EXPERIMENTS=${SURF_LOCAL_EXPERIMENTS:-$TRACKER_SOURCE/experiments}
DESTINATION=${SURF_EXPERIMENT_DESTINATION:-$PROJECT_ROOT/experiments}
DRONE_EXPERIMENTS=${SURF_DRONE_EXPERIMENTS:?Set SURF_DRONE_EXPERIMENTS to user@peer:/telemetry/path}

if [[ ! -d $TRACKER_SOURCE/surf_data_tracker ]]; then
    echo "surf_data_tracker source not found under $PROJECT_ROOT" >&2
    echo "Set SURF_PROJECT_ROOT to the repository checkout." >&2
    exit 1
fi
if [[ ! -d $LOCAL_EXPERIMENTS/$RUN_ID/hosts ]]; then
    echo "Local humanoid run not found: $LOCAL_EXPERIMENTS/$RUN_ID/hosts" >&2
    exit 1
fi

echo "Collecting $RUN_ID from the drone and this laptop..."
PYTHONPATH=$TRACKER_SOURCE python3 -m surf_data_tracker.collect "$RUN_ID" \
    --destination "$DESTINATION" \
    --source "drone=$DRONE_EXPERIMENTS" \
    --source "humanoid=$LOCAL_EXPERIMENTS"

echo "Analyzing $DESTINATION/$RUN_ID..."
MPLCONFIGDIR=${MPLCONFIGDIR:-/tmp/surf-matplotlib-$UID} \
PYTHONPATH=$TRACKER_SOURCE \
    python3 -m surf_data_tracker.analysis "$DESTINATION/$RUN_ID"

echo
echo "Complete: $DESTINATION/$RUN_ID"
echo "Summary:  $DESTINATION/$RUN_ID/summary.csv"
echo "Plots:    $DESTINATION/$RUN_ID/plots"
