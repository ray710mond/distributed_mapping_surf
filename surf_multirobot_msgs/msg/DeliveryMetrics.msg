# Receiver-side measurements, correlated with PipelineMetrics by source/epoch/version/class.
std_msgs/Header header
builtin_interfaces/Time sensor_stamp
builtin_interfaces/Time transmit_stamp
string source_id
uint64 map_epoch
uint64 version
uint8 traffic_class
uint32 wire_bytes
uint32 voxel_count
uint32 chunk_index
uint32 chunk_count
float32 transport_latency_ms
float32 sender_to_receiver_ms
float32 sensor_to_receiver_ms
float32 decode_latency_ms
float32 codec_reconstruction_ms
float32 receiver_processing_ms
float32 end_to_end_latency_ms
bool accepted
string rejection_reason

uint64 stale_voxels_rejected
uint64 applied_temporal_regressions

uint64 attempted_temporal_regressions

# Ages of accepted voxel observation stamps, not the latest scan header.
uint32 accepted_voxel_count
float64 oldest_accepted_observation_age_s
float64 newest_accepted_observation_age_s
float64 mean_accepted_observation_age_s
